{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "bun run --cwd ../client build:wasm",
    "dev": "bun run build:wasm && vite dev",
    "build": "bun run build:wasm && vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run build:wasm && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:rpm": "tauri build --bundles rpm"
  },
  "dependencies": {
    "@iroh-fm/client": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "oxfmt": "^0.59.0",
    "virtua": "^0.49.3"
  },
  "devDependencies": {
    "@iconify-json/ri": "^1.2.10",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/cli": "^2.11.4",
    "oxlint": "^1.74.0",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "https://pkg.pr.new/svelte@18558",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.16"
  }
}

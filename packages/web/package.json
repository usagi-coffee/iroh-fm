{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "generate:types": "bun run --cwd ../client generate:types",
    "build:wasm": "bun run --cwd ../client build:wasm",
    "dev": "bun run build:wasm && vite dev",
    "dev:e2e:web": "vite dev --mode e2e-web --host 127.0.0.1 --port 4173 --strictPort",
    "dev:e2e:desktop": "vite dev --mode e2e-desktop --host 127.0.0.1 --port 4174 --strictPort",
    "dev:e2e:android": "vite dev --mode e2e-android --host 127.0.0.1 --port 4175 --strictPort",
    "build": "bun run build:wasm && bun run build:prepared",
    "build:prepared": "vite build && bun scripts/validate-service-worker.js",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "bun run build:wasm && bun run check:prepared",
    "check:prepared": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json && tsc --noEmit -p src/service-worker/tsconfig.json",
    "check:watch": "bun run generate:types && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
    "test:service-worker": "node --test scripts/service-worker.test.js scripts/service-worker-client.test.js",
    "test:e2e": "bun run generate:types && playwright test",
    "test:e2e:ui": "bun run generate:types && playwright test --ui",
    "desktop": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:build:rpm": "tauri build --bundles rpm"
  },
  "dependencies": {
    "@iroh-fm/client": "workspace:*",
    "@tauri-apps/api": "catalog:desktop",
    "wanakana": "^5.3.1"
  },
  "devDependencies": {
    "@iconify-json/ri": "catalog:web",
    "@playwright/test": "catalog:web",
    "@sveltejs/adapter-static": "catalog:web",
    "@sveltejs/kit": "catalog:web",
    "@sveltejs/vite-plugin-svelte": "catalog:web",
    "@tailwindcss/vite": "catalog:web",
    "@tauri-apps/cli": "catalog:desktop",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "svelte": "catalog:web",
    "svelte-check": "catalog:web",
    "tailwindcss": "catalog:web",
    "typescript": "catalog:",
    "unplugin-icons": "catalog:web",
    "vite": "catalog:web"
  },
  "engines": {
    "node": ">=22.17"
  }
}

{
  "name": "iroh-fm",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "check": "bun run --cwd packages/web check",
    "format": "oxfmt .;cargo fmt",
    "lint": "oxlint .; cargo clippy"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "prettier-plugin-svelte": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
